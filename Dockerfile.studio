# Nexus Studio container for hosted (team-mode) deployments behind an HTTPS proxy.
# See docker-compose.studio.yml and deploy/studio/PERSONAL-VM.md.
# Team mode needs the Nexus auth stack (Postgres credential store, AES-GCM
# credential crypto) plus the API provider adapters; coding CLIs never run here.
FROM python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml README.md LICENSE MANIFEST.in /nexus-arc/
COPY nexus /nexus-arc/nexus
RUN pip install --no-cache-dir "/nexus-arc[postgres,openai,anthropic,documents,mcp]" "cryptography>=42.0" \
    && rm -rf /nexus-arc

EXPOSE 5003

ENTRYPOINT ["nexus", "studio"]
