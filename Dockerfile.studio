# Nexus Studio container for hosted (team-mode) deployments behind an HTTPS proxy.
# See docker-compose.studio.yml and deploy/studio/PERSONAL-VM.md.
# Team mode needs the Nexus auth stack (Postgres credential store, AES-GCM
# credential crypto) plus the API provider adapters; coding CLIs never run here.
# Subscription CLIs (runner_image) run as sibling containers through the docker
# CLI below and the host socket mounted by docker-compose.studio.yml.
FROM docker:29.8.2-cli@sha256:35cfcf893c20f2931f4909151b5407aaaeab711277de7ce8b8f521f095d54c32 AS docker-cli

FROM python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
# git versions the workspace so applied changes can be reverted (studio_workspace_git.py).
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE MANIFEST.in /nexus-arc/
COPY nexus /nexus-arc/nexus
# MCP 2's httpx2 dependency does not supply the httpx used by delegated OAuth.
RUN pip install --no-cache-dir "/nexus-arc[postgres,openai,anthropic,documents,mcp,studio-oauth]" "cryptography>=42.0" \
    && rm -rf /nexus-arc

EXPOSE 5003

ENTRYPOINT ["nexus", "studio"]
