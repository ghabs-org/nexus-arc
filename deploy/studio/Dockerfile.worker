# Supply a reviewed Node image digest and exact official CLI versions.
ARG NODE_IMAGE
FROM ${NODE_IMAGE}
ARG CODEX_VERSION
ARG CLAUDE_CODE_VERSION
# Optional Google Antigravity CLI: the versioned archive URL and SHA-512 from the
# official release manifest (see deploy/studio/README.md). Empty skips agy.
ARG AGY_URL=
ARG AGY_SHA512=
# Optional OpenCode CLI: the versioned Linux archive URL and SHA-256 from the official
# release (see deploy/studio/README.md). Empty skips opencode.
ARG OPENCODE_URL=
ARG OPENCODE_SHA256=
# Slim Node images ship no CA bundle. Node has its own roots, but Codex (Rust)
# verifies TLS against the system store and fails every request without one.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN test -n "$CODEX_VERSION" && test -n "$CLAUDE_CODE_VERSION" \
    && npm install --global "@openai/codex@${CODEX_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force
RUN if [ -n "$AGY_URL" ]; then \
      test -n "$AGY_SHA512" \
      && node -e 'fetch(process.env.AGY_URL).then(r => { if (!r.ok) throw new Error("HTTP " + r.status); return r.arrayBuffer(); }).then(b => require("fs").writeFileSync("/tmp/agy.tgz", Buffer.from(b)))' \
      && echo "$AGY_SHA512  /tmp/agy.tgz" | sha512sum -c - \
      && tar -xzf /tmp/agy.tgz -C /tmp antigravity \
      && install -m 0755 /tmp/antigravity /usr/local/bin/agy \
      && rm -f /tmp/agy.tgz /tmp/antigravity; \
    fi
RUN if [ -n "$OPENCODE_URL" ]; then \
      test -n "$OPENCODE_SHA256" \
      && node -e 'fetch(process.env.OPENCODE_URL).then(r => { if (!r.ok) throw new Error("HTTP " + r.status); return r.arrayBuffer(); }).then(b => require("fs").writeFileSync("/tmp/opencode.tgz", Buffer.from(b)))' \
      && echo "$OPENCODE_SHA256  /tmp/opencode.tgz" | sha256sum -c - \
      && tar -xzf /tmp/opencode.tgz -C /tmp opencode \
      && install -m 0755 /tmp/opencode /usr/local/bin/opencode \
      && rm -f /tmp/opencode.tgz /tmp/opencode; \
    fi
ENV DISABLE_AUTOUPDATER=1 OPENCODE_DISABLE_AUTOUPDATE=1
WORKDIR /workspace
# Studio supplies the numeric service UID and per-user mounts at invocation.
CMD ["codex", "--version"]
